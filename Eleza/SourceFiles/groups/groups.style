// Groups: the info screen (cover, rows, members), the boxes of creating a
// group, invite links, join requests, administration.
using "ui/basic.style";
using "ui/widgets/widgets.style";
using "ui/layers/layers.style";

groupsColumnWidth: 620px;
groupsBottomSkip: 24px;

// ---- the cover
groupsCoverPadding: margins(24px, 22px, 24px, 14px);
groupsCoverUserpic: 96px;
groupsCoverNameSkip: 14px;
groupsCoverNameStyle: TextStyle(defaultTextStyle) {
	font: font(20px bold);
	lineHeight: 28px;
}
groupsCoverCountFont: font(14px);
groupsCoverCountSkip: 4px;
groupsAboutLabel: FlatLabel(defaultFlatLabel) {
	textFg: textPrimary;
}
groupsAboutPadding: margins(24px, 4px, 24px, 12px);
groupsSectionTitle: FlatLabel(defaultFlatLabel) {
	style: semiboldTextStyle;
	textFg: brandText;
}
groupsSectionTitlePadding: margins(24px, 14px, 24px, 6px);
groupsFootnote: FlatLabel(defaultFlatLabel) {
	style: smallTextStyle;
	textFg: textTertiary;
}
groupsFootnotePadding: margins(24px, 6px, 24px, 10px);
groupsDividerHeight: 9px;

// ---- rows
groupsButton: SettingsButton(defaultSettingsButton) {
	height: 48px;
	padding: margins(24px, 0px, 24px, 0px);
	iconSkip: 40px;
}
groupsDangerButton: SettingsButton(groupsButton) {
	textFg: statusError;
	textFgOver: statusError;
	ripple: dangerRipple;
}
groupsIconInfo: icon {{ "info", textSecondary }};
groupsIconGroup: icon {{ "group", textSecondary }};
groupsIconNotify: icon {{ "notifications", textSecondary }};
groupsIconAdd: icon {{ "follow", textSecondary }};
groupsIconLink: icon {{ "link", textSecondary }};
groupsIconRequests: icon {{ "request", textSecondary }};
groupsIconPermissions: icon {{ "lock", textSecondary }};
groupsIconAdmins: icon {{ "star", textSecondary }};
groupsIconRestricted: icon {{ "mute", textSecondary }};
groupsIconBanned: icon {{ "block", textSecondary }};
groupsIconEdit: icon {{ "edit", textSecondary }};
groupsIconChat: icon {{ "message", textSecondary }};
groupsIconClear: icon {{ "refresh", textSecondary }};
groupsIconReport: icon {{ "report", textSecondary }};
groupsIconLeaveDanger: icon {{ "logout:mirror-rtl", statusError }};
groupsIconDeleteDanger: icon {{ "trash", statusError }};
groupsMenuGroup: icon {{ "group", menuIconFg, 20px }};
groupsMenuLeave: icon {{ "logout:mirror-rtl", menuIconFg, 20px }};
groupsMenuClear: icon {{ "refresh", menuIconFg, 20px }};
groupsMenuUser: icon {{ "me", menuIconFg, 20px }};
groupsMenuAdmin: icon {{ "star", menuIconFg, 20px }};
groupsMenuRestrict: icon {{ "mute", menuIconFg, 20px }};
groupsMenuApprove: icon {{ "check", menuIconFg, 20px }};
groupsMenuDecline: icon {{ "close", menuIconFg, 20px }};

// ---- members
groupsMemberHeight: 58px;
groupsMemberPadding: margins(24px, 0px, 24px, 0px);
groupsMemberUserpic: 40px;
groupsMemberUserpicSkip: 12px;
groupsMemberNameFont: font(15px medium);
groupsMemberNameTop: 9px;
groupsMemberStatusFont: font(13px);
groupsMemberStatusTop: 31px;
groupsMemberTagFont: font(12px);
groupsMemberTagSkip: 10px;
groupsMemberRadius: 10px;
groupsMemberMargin: 8px;

// ---- boxes
groupsInviteUserpic: 88px;
groupsInvitePadding: margins(24px, 8px, 24px, 12px);
groupsInviteTitle: FlatLabel(defaultFlatLabel) {
	style: groupsCoverNameStyle;
	align: align(top);
}
groupsInviteCount: FlatLabel(defaultFlatLabel) {
	textFg: textSecondary;
	align: align(top);
}
groupsInviteNote: FlatLabel(defaultFlatLabel) {
	style: smallTextStyle;
	textFg: textTertiary;
	align: align(top);
}
groupsBoxCaption: FlatLabel(defaultFlatLabel) {
	style: smallTextStyle;
	textFg: textTertiary;
}

// ---- the third release: slow mode, hidden members, recent actions, media
groupsIconSlow: icon {{ "timer", textSecondary }};
groupsIconHide: icon {{ "eye-off", textSecondary }};
groupsIconLog: icon {{ "thread", textSecondary }};
groupsIconMedia: icon {{ "image", textSecondary }};
groupsMenuJoined: icon {{ "follow", menuIconFg, 20px }};
groupsMenuDeclineAll: icon {{ "close-circle", menuIconFg, 20px }};
groupsHiddenNotePadding: margins(24px, 2px, 24px, 6px);

groupsLogPadding: margins(24px, 10px, 24px, 10px);
groupsLogUserpic: 36px;
groupsLogUserpicSkip: 12px;
groupsLogTextStyle: TextStyle(defaultTextStyle) {
	font: font(14px);
	lineHeight: 20px;
}
groupsLogTimeFont: font(12px);
groupsLogTimeSkip: 2px;
groupsLogStateHeight: 56px;
groupsLogStateFont: font(13px);

// ---- member tags
groupsMenuTag: icon {{ "tag", menuIconFg, 20px }};
// The tag at the end of a member row.
groupsMemberTagPillFont: font(13px);
groupsMemberTagHeight: 24px;     // a pill (owner / admin, the «add tag» button, a tag I may edit)
groupsMemberTagPadding: 10px;    // its sides
groupsMemberTagMax: 140px;       // a long tag is cut there

// The box a tap on a tag opens (Telegram's TagInfoBox).
groupsTagInfoClose: IconButton(smallCloseButton) {
}
groupsTagInfoCloseTop: 10px;
groupsTagInfoLogo: 76px;
groupsTagInfoIcon: icon {{ "tag-user", staticWhite, 44px }};
groupsTagInfoLogoPadding: margins(24px, 28px, 24px, 16px);
groupsTagInfoTitleStyle: TextStyle(defaultTextStyle) {
	font: font(19px bold);
	lineHeight: 26px;
}
groupsTagInfoTitle: FlatLabel(defaultFlatLabel) {
	style: groupsTagInfoTitleStyle;
	align: align(top);
}
groupsTagInfoTitlePadding: margins(24px, 0px, 24px, 8px);
groupsTagInfoTextStyle: TextStyle(defaultTextStyle) {
	font: font(15px);
	lineHeight: 26px;
}
groupsTagInfoTextBold: font(15px semibold);
groupsTagInfoTextPadding: margins(28px, 0px, 28px, 16px);
groupsTagInfoPillFont: font(13px);
groupsTagInfoPillHeight: 20px;
groupsTagInfoPillPadding: 7px;
groupsTagInfoAdminsOnly: FlatLabel(defaultFlatLabel) {
	style: smallTextStyle;
	textFg: textTertiary;
	align: align(top);
}
groupsTagInfoAdminsOnlyPadding: margins(24px, 4px, 24px, 4px);
// The two cards: a member's tag and an admin's (or the owner's).
groupsTagInfoPreviewHeight: 96px;
groupsTagInfoPreviewGap: 10px;
groupsTagInfoPreviewRadius: 14px;
groupsTagInfoPreviewPadding: margins(24px, 4px, 24px, 18px);
groupsTagInfoBubbleTop: 14px;
groupsTagInfoBubbleBottom: 14px;
groupsTagInfoBubbleEnd: 16px;     // between the bubble and the card's end
groupsTagInfoBubblePadding: 12px; // inside the bubble
groupsTagInfoBubbleRadius: 14px;
groupsTagInfoBadgeTop: 9px;
groupsTagInfoLineHeight: 7px;
groupsTagInfoLineSkip: 6px;
groupsTagInfoTimeFont: font(11px);
groupsTagInfoFade: 40px;

// The box that sets a tag (Telegram's EditCustomRankBox): a preview of the
// bubble, the field, what the tag is.
groupsTagEditPreviewPadding: margins(16px, 16px, 16px, 16px);
groupsTagEditBubbleWidth: 250px;
groupsTagEditBubblePadding: margins(12px, 8px, 12px, 10px);
groupsTagEditBubbleRadius: 16px;
groupsTagEditLineHeight: 7px;
groupsTagEditLineSkip: 6px;
groupsTagEditFieldPadding: margins(24px, 14px, 24px, 6px);
groupsTagEditAboutPadding: margins(24px, 4px, 24px, 12px);
