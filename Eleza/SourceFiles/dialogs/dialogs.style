// The chat list: the side column of the «گفتگو» tab.
using "ui/basic.style";
using "ui/widgets/widgets.style";

// ---- the column
dialogsSearchPadding: margins(12px, 2px, 12px, 8px);
dialogsNewMessageButton: IconButton(topBarCreateButton) {
}
dialogsTabs: TabBar(defaultTabBar) {
	height: 40px;
}
dialogsBannerHeight: 36px;
dialogsBannerBg: statusErrorSoft;
dialogsBannerFg: textPrimary;
dialogsBannerFont: font(13px);
dialogsBannerActionFont: font(13px semibold);
dialogsBannerActionFg: statusError;
dialogsBannerPadding: margins(16px, 0px, 16px, 0px);

// ---- rows
dialogsRowHeight: 68px;
dialogsPadding: margins(12px, 10px, 12px, 10px);
dialogsUserpicSize: 48px;
dialogsUserpicSkip: 12px;
dialogsRowRadius: 12px;
dialogsRowMargin: 6px;      // horizontal inset of the hover / active highlight
dialogsBg: bgCanvas;
dialogsBgOver: stateHover;
dialogsBgActive: stateActive;
dialogsRipple: RippleAnimation(defaultRipple) {
}

dialogsNameFont: font(15px semibold);
dialogsNameFg: textPrimary;
dialogsTopicFont: font(17px bold "display");
dialogsAnonFg: anonContent;
dialogsNameTop: 11px;
dialogsVerifiedIcon: icon {{ "verified_active", brandPrimary, 16px }};
dialogsMuteIcon: icon {{ "mute", textTertiary, 14px }};
dialogsPinIcon: icon {{ "pin", textTertiary, 16px }};
dialogsNameIconSkip: 4px;

dialogsDateFont: font(12px);
dialogsDateFg: textTertiary;
dialogsDateFgUnread: brandText;
dialogsDateTop: 13px;
dialogsDateSkip: 8px;
dialogsTickSent: icon {{ "check", brandPrimary, 16px }};
dialogsTickRead: icon {{ "check-double", brandPrimary, 16px }};
dialogsTickPending: icon {{ "clock", textTertiary, 14px }};
dialogsTickFailed: icon {{ "warning", statusError, 16px }};
dialogsTickSkip: 3px;

dialogsTextFont: font(14px);
// A title / preview with emoji of the pack (drawn through Ui::Text::String).
dialogsNameTextStyle: TextStyle(defaultTextStyle) {
	font: dialogsNameFont;
}
dialogsTopicTextStyle: TextStyle(defaultTextStyle) {
	font: dialogsTopicFont;
}
dialogsPreviewTextStyle: TextStyle(defaultTextStyle) {
	font: dialogsTextFont;
}
dialogsTextFg: textSecondary;
dialogsTextFgService: brandText;
dialogsTextFgDraft: statusError;
dialogsTextFgActivity: brandText;
dialogsTextTop: 35px;
dialogsThumbSize: 20px;
dialogsThumbRadius: 4px;
dialogsThumbSkip: 6px;
dialogsThumbTop: 36px;

dialogsBadge: Badge(defaultBadge) {
	font: font(12px semibold);
	height: 20px;
	padding: 6px;
}
dialogsBadgeTop: 36px;
dialogsBadgeSkip: 8px;
dialogsMentionSkip: 4px;

// ---- the «درخواست‌ها» / «بایگانی» entries
dialogsFolderBg: bgSunken;
dialogsFolderRequestsIcon: icon {{ "request", textSecondary, 24px }};
dialogsFolderArchiveIcon: icon {{ "archive", textSecondary, 24px }};
dialogsFolderTextFg: textTertiary;

// ---- dragging a pinned chat
dialogsDragBg: bgRaised;
dialogsDragShadow: Shadow(smallShadow) {
	blur: 10px;
	offset: point(0px, 2px);
	extend: margins(12px, 10px, 12px, 14px);
}

// ---- menus and boxes
dialogsMenuRead: icon {{ "check-double", menuIconFg, 20px }};
dialogsMenuProfile: icon {{ "me", menuIconFg, 20px }};
dialogsMenuAccept: icon {{ "check", menuIconFg, 20px }};
dialogsMenuDecline: icon {{ "close", menuIconFg, 20px }};
dialogsMenuClock: icon {{ "clock", menuIconFg, 20px }};

// ---- notes (dialogs_notes.h): the row on top of the list, the faces next to
// the title while it is out of sight, «نوت جدید» and a friend's note
dialogsNotesPadding: margins(8px, 8px, 8px, 8px);
dialogsNotesItemWidth: 80px;
dialogsNotesUserpic: 56px;
dialogsNotesBubbleFont: font(12px);
dialogsNotesBubbleHeight: 26px;
dialogsNotesBubblePadding: 8px;
dialogsNotesBubbleRadius: 12px;
dialogsNotesBubbleSkip: 9px;   // between the bubble and the face (its dots)
dialogsNotesBubbleBg: bgRaised;
dialogsNotesBubbleBorder: borderSubtle;
dialogsNotesBubbleFg: textPrimary;
dialogsNotesBubbleFgEmpty: textTertiary;
dialogsNotesCloseFriendsFg: statusSuccess;
dialogsNotesNameTop: 4px;
dialogsNotesNameFont: font(12px);
dialogsNotesNameFg: textSecondary;
dialogsNotesBgOver: stateHover;
dialogsNotesLineFg: borderSubtle;
dialogsNotesAddSize: 20px;
dialogsNotesAddBorder: 2px;
dialogsNotesAddBg: brandPrimary;
dialogsNotesAddIcon: icon {{ "plus", textOnBrand, 14px }};
dialogsNotesArrowSize: 28px;
dialogsNotesArrowBg: bgRaised;
dialogsNotesArrowLeft: icon {{ "chevron-left", textSecondary, 18px }};
dialogsNotesArrowRight: icon {{ "chevron-right", textSecondary, 18px }};
dialogsNotesFace: 26px;
dialogsNotesFaceOverlap: 9px;
dialogsNotesFaceBorder: 2px;
dialogsNotesFacesHeight: 34px;
dialogsNotesMenuMessage: icon {{ "message", menuIconFg, 20px }};
dialogsNotesMenuProfile: icon {{ "me", menuIconFg, 20px }};
dialogsNotesMenuHide: icon {{ "eye-off", menuIconFg, 20px }};
dialogsNotesMenuEdit: icon {{ "edit", menuIconFg, 20px }};

// the boxes: the note in a speech bubble over the face
dialogsNoteStageUserpic: 72px;
dialogsNoteStageTop: 8px;
dialogsNoteStageBottom: 12px;
dialogsNoteStageSkip: 12px;
dialogsNoteStageMaxWidth: 280px;
dialogsNoteStageMinWidth: 120px;
dialogsNoteStagePadding: margins(14px, 9px, 14px, 10px);
dialogsNoteStageRadius: 18px;
dialogsNoteStageLines: 3;
dialogsNoteStageTextStyle: TextStyle(defaultTextStyle) {
	font: font(15px);
	lineHeight: 22px;
}
dialogsNoteField: InputField(defaultInputField) {
}
dialogsNoteCounter: FlatLabel(captionLabel) {
}
dialogsNoteCounterOverFg: statusError;
dialogsNoteBylineFont: font(13px);
dialogsNoteBylineFg: textSecondary;
