// Shared session helpers: the connection label, desktop notifications, the
// "open this link?" box.
using "ui/basic.style";
using "ui/widgets/widgets.style";

connectionLabelHeight: 24px;
connectionLabelSpinner: 14px;
connectionLabelSkip: 8px;
connectionLabelFont: font(13px);

// ---- notification toasts at the screen corner
notifyWidth: 340px;
notifyMinHeight: 76px;
notifyRadius: 14px;
notifyBg: bgRaised;
notifyBorder: borderSubtle;
notifyPadding: margins(12px, 12px, 12px, 12px);
notifyUserpicSize: 44px;
notifyUserpicSkip: 12px;
notifyTitleFont: semiboldFont;
notifyTitleFg: textPrimary;
notifyTextStyle: TextStyle(defaultTextStyle) {
	font: font(13px);
}
notifyTextFg: textSecondary;
notifyTextTop: 4px;
notifyTextLines: 2;
notifyAppFont: microFont;
notifyAppFg: textTertiary;
notifyScreenMargin: 16px;
notifySkip: 10px;
notifyShadow: Shadow(defaultShadow) {
	blur: 12px;
	offset: point(0px, 3px);
	extend: margins(14px, 11px, 14px, 17px);
}
notifyClose: IconButton(smallCloseButton) {
}
notifyCloseSkip: 4px;
notifyShowDuration: 180ms;
notifyHideDuration: 160ms;
