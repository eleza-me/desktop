// Settings: the «به‌روزرسانی» page.
using "ui/basic.style";
using "ui/widgets/widgets.style";

settingsIconUpdate: icon {{ "refresh", textSecondary }};

// ---- the status block: what is known, how far the download is, the action
settingsUpdateStatusPadding: margins(24px, 14px, 24px, 14px);
settingsUpdateTitleStyle: TextStyle(defaultTextStyle) {
	font: font(17px semibold);
	lineHeight: 26px;
}
settingsUpdateTitleFg: textPrimary;
settingsUpdateErrorFg: statusError;
settingsUpdateCaptionStyle: TextStyle(defaultTextStyle) {
	font: font(13px);
	lineHeight: 20px;
}
settingsUpdateCaptionFg: textTertiary;
settingsUpdateCaptionSkip: 4px;
settingsUpdateBarSkip: 12px;
settingsUpdateBarHeight: 6px;
settingsUpdateBarBg: borderSubtle;
settingsUpdateBarFg: brandPrimary;
settingsUpdateButtonSkip: 16px;
settingsUpdateButton: RoundButton(defaultRoundButton) {
}
settingsUpdateLightButton: RoundButton(lightRoundButton) {
}

// ---- the release notes
settingsUpdateNotesMargin: margins(24px, 4px, 24px, 8px);
settingsUpdateNotesPadding: margins(16px, 12px, 16px, 14px);
settingsUpdateNotesBg: bgSunken;
settingsUpdateNotesRadius: 12px;
settingsUpdateNotesTitleFont: font(14px semibold);
settingsUpdateNotesTitleFg: textPrimary;
settingsUpdateNotesTitleSkip: 8px;
settingsUpdateNotesStyle: TextStyle(defaultTextStyle) {
	font: font(14px);
	lineHeight: 23px;
}
settingsUpdateNotesFg: textSecondary;
