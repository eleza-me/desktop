// Windows resources of Eleza.exe: the application icon and the version block.
// Configured by Eleza/CMakeLists.txt.
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/Resources/art/Eleza.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @ELEZA_RC_VERSION_COMMA@
PRODUCTVERSION @ELEZA_RC_VERSION_COMMA@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "eleza"
			VALUE "FileDescription", "Eleza Desktop"
			VALUE "FileVersion", "@PROJECT_VERSION@"
			VALUE "InternalName", "Eleza"
			VALUE "LegalCopyright", "Copyright (C) eleza"
			VALUE "OriginalFilename", "Eleza.exe"
			VALUE "ProductName", "Eleza Desktop"
			VALUE "ProductVersion", "@PROJECT_VERSION@"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
